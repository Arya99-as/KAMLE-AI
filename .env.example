# ============================================================================
# KAMLE AI - environment variables (placeholder values only, no real secrets)
# Copy this file to `.env` inside the `server/` folder and fill in real values.
# The frontend does NOT need secrets: only the backend talks to the AI provider.
# ============================================================================

# ---- Server ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma separated list of origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

# ---- Database --------------------------------------------------------------
# Local MongoDB instance
MONGODB_URI=mongodb://127.0.0.1:27017/kamle_ai
# Set to "true" to spin up an ephemeral in-memory MongoDB (handy for demos/tests
# when you do not have MongoDB installed). Do NOT use in production.
USE_MEMORY_DB=false

# ---- Auth ------------------------------------------------------------------
# Generate a strong secret: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- AI provider (server-side only, key never shipped to the browser) ------
# provider: openai | groq | ollama | gemini | heuristic
# "heuristic" is a built-in deterministic parser and needs no key.
AI_PROVIDER=heuristic
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=20000

# ---- Uploads ---------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=30
