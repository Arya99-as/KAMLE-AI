# Copy to .env and adjust. NEVER commit .env with real secrets.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/kamle_ai
USE_MEMORY_DB=false

JWT_SECRET=change_me_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# ── AI provider ─────────────────────────────────────────────────────────────
# provider:  heuristic (default, no key) | openai | groq | ollama | gemini
# If AI_BASE_URL / AI_MODEL are left empty, sensible defaults are used:
#   openai -> https://api.openai.com/v1            + gpt-4o-mini
#   groq   -> https://api.groq.com/openai/v1       + llama-3.3-70b-versatile
#   ollama -> http://localhost:11434/v1            + llama3.2
#   gemini -> https://generativelanguage.googleapis.com/v1beta + gemini-3.5-flash-lite
#
# Gemini is the easiest provider if unavailable models cause failures:
#   AI_PROVIDER=gemini
#   AI_API_KEY=your_google_generative_language_api_key
#
# The key is used server-side only and never sent to the browser.
# If the provider fails or returns invalid JSON the API auto-falls-back to the
# deterministic heuristic parser with degraded:true (product never breaks).
AI_PROVIDER=heuristic
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_FALLBACK_MODELS=
AI_TIMEOUT_MS=8000

# ---- Payments -------------------------------------------------------------
# provider: mock (default, simulated in development only) | razorpay
# mock is rejected automatically when NODE_ENV=production.
# razorpay requires the two keys below and a webhook secret.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional legacy signing secret (kept for migration; provider adapters do not use it)
PAYMENT_SECRET=

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=30