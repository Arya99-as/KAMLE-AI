# KAMLE AI Server Environment Configuration
# Copy this file to .env and update with your values

# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/kamle_ai
USE_MEMORY_DB=false

# Authentication
JWT_SECRET=change_me_to_a_strong_secret
JWT_EXPIRES_IN=7d

# AI Provider Configuration
# Options: openai, groq, ollama, gemini, heuristic
AI_PROVIDER=heuristic
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_FALLBACK_MODELS=
AI_TIMEOUT_MS=8000

# File Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Payment Configuration (Razorpay)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_SECRET=dev_only_payment_signing_secret_change_me

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Google Maps Platform
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_MAX=30

# Demo Quick Access Configuration
# Enabled automatically in development. For production/staging, set DEMO_LOGIN_ENABLED=true
DEMO_LOGIN_ENABLED=false
DEMO_ADMIN_IDENTIFIER=admin@kamle.ai
DEMO_CUSTOMER_IDENTIFIER=customer@example.com
DEMO_WORKER_IDENTIFIER=9800000001

